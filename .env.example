# Copy this file to ".env" in the same folder and fill in your real key.
#
#     copy .env.example .env
#
# .env is listed in .gitignore, so it never gets committed. This template is
# safe to commit precisely because it contains no real values.
#
# Get a Gemini key from Google AI Studio: https://aistudio.google.com/apikey
# Used by ai_model/llm_fallback.py to escalate low-confidence predictions.
# Without it the app still runs - it just keeps the local model's prediction
# instead of asking for a second opinion.

GEMINI_API_KEY=paste_your_key_here

# Get a YouTube Data API v3 key from Google Cloud Console:
# console.cloud.google.com -> APIs & Services -> Library -> enable
# "YouTube Data API v3" -> Credentials -> Create Credentials -> API Key.
# Used by social_media/collector.py to fetch video comments.
YOUTUBE_API_KEY=paste_your_key_here

# Gmail account used to SEND alert emails (needs an App Password, not your
# regular login password - Google Account -> Security -> 2-Step Verification
# -> App Passwords). NGO_EMAIL is who receives the alerts.
# Used by email_service/send_email.py.
SENDER_EMAIL=paste_sender_gmail_here
SENDER_APP_PASSWORD=paste_16_char_app_password_here
NGO_EMAIL=paste_recipient_email_here

# Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials
# -> OAuth client ID -> Application type: Web application -> Authorized
# redirect URI: http://localhost:8000/auth/callback. Also requires the OAuth
# consent screen to have workhappy723@gmail.com added as a Test user.
# Used by backend/oauth_store.py to let the dashboard log in as your channel.
GOOGLE_OAUTH_CLIENT_ID=paste_your_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=paste_your_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
FRONTEND_URL=http://localhost:5173

# developers.facebook.com -> My Apps -> Create App ("Business" type) -> add
# use cases "Manage everything on your Page" + "Manage messaging & content on
# Instagram" -> link a Business Portfolio (Business Settings -> add/create one -
# unlocks the System-user access token + asset picker the use case wizards
# need) -> under each use case's Customize > Permissions, add:
#   pages_show_list, pages_read_engagement, pages_read_user_content,
#   instagram_business_basic, instagram_business_manage_comments
# -> App Roles > Roles, add your own Facebook/Instagram account as a
# Tester (accept the invite from the Instagram app's own Settings > Apps and
# Websites) -> add a Privacy Policy URL and Publish the app (Development mode
# blocks the /comments edge's actual content even for your own Tester
# account) -> Facebook Login for Business > Settings > Valid OAuth Redirect
# URIs: http://localhost:8000/auth/meta/callback -> Settings > Basic for App
# ID/Secret. One login covers both Instagram and Facebook (they share the
# same Meta app + Page access) - an Instagram account only works here once
# it's a Business/Creator account linked to one of your Facebook Pages.
# Used by backend/meta_oauth_store.py.
META_APP_ID=paste_your_app_id_here
META_APP_SECRET=paste_your_app_secret_here
META_OAUTH_REDIRECT_URI=http://localhost:8000/auth/meta/callback

# THIS is what Instagram/Facebook monitoring actually uses. "Facebook Login
# for Business" locks "Enforce HTTPS" on for redirect URIs (the toggle is
# greyed out in the app console), so it rejects http://localhost:8000/... and
# the browser OAuth flow above can't complete against a local dev server. A
# Page Access Token skips it entirely, which costs nothing here - this
# dashboard only monitors its own owner's Page and linked Instagram account.
#
# To mint one that never expires:
#   1. developers.facebook.com -> Tools -> Graph API Explorer
#   2. Meta App: your app. User or Page: "Get User Access Token"
#      (a *user* token, not a Page one), grant the permissions, copy it.
#   3. python -m backend.meta_oauth_store --exchange <that_token>
#   4. Paste the META_PAGE_ACCESS_TOKEN= line it prints below.
META_PAGE_ACCESS_TOKEN=paste_your_page_access_token_here
